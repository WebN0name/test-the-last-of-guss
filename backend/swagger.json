                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "415": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "refresh_token": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    },
    "/api/rounds": {
      "get": {
        "operationId": "RoundsController_list",
        "parameters": [
          {
            "name": "scope",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "current",
                "finished"
              ]
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Непрозрачный курсор из nextCursor предыдущей страницы того же scope; курсор другого scope или повреждённый → 400 INVALID_CURSOR",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoundListResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "tags": [
          "rounds"
        ]
      },
      "post": {
        "operationId": "RoundsController_create",
        "parameters": [],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRoundResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "tags": [
          "rounds"
        ]
      }
    },
    "/api/rounds/{id}": {
      "get": {
        "operationId": "RoundsController_get",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoundResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "tags": [
          "rounds"
        ]
      }
    },
    "/api/rounds/{id}/taps": {
      "post": {
        "operationId": "RoundsController_tap",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TapDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TapResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "415": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "tags": [
          "rounds"
        ]
      }
    }
  },
  "info": {
    "title": "The Last of Guss API",
    "description": "Кликер: раунды, тапы по гусю, очки. Все мутации — POST с JSON, сессия — httpOnly cookie.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access_token": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token"
      },
      "refresh_token": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "example": "Иван",
            "minLength": 3,
            "maxLength": 32
          },
          "password": {
            "type": "string",
            "example": "secret-1",
            "minLength": 6
          }
        },
        "required": [
          "login",
          "password"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "login": {
            "type": "string",
            "example": "Иван"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "survivor",
              "nikita"
            ]
          }
        },
        "required": [
          "id",
          "login",
          "role"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto"
          },
          "created": {
            "type": "boolean",
            "description": "true, если пользователь был создан этим запросом"
          }
        },
        "required": [
          "user",
          "created"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "code": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "required": [
          "statusCode",
          "code",
          "message"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "user"
        ]
      },
      "CreatorDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "login": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "login"
        ]
      },
      "RoundDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "creator": {
            "$ref": "#/components/schemas/CreatorDto"
          },
          "startAt": {
            "type": "string",
            "format": "date-time"
          },
          "endAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "cooldown",
              "active",
              "finished"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "creator",
          "startAt",
          "endAt",
          "status",
          "createdAt"
        ]
      },
      "RoundListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoundDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "items",
          "nextCursor",
          "serverTime"
        ]
      },
      "CreateRoundResponseDto": {
        "type": "object",
        "properties": {
          "round": {
            "$ref": "#/components/schemas/RoundDto"
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "round",
          "serverTime"
        ]
      },
      "MyScoreDto": {
        "type": "object",
        "properties": {
          "taps": {
            "type": "integer"
          },
          "score": {
            "type": "integer"
          }
        },
        "required": [
          "taps",
          "score"
        ]
      },
      "WinnerDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "login": {
            "type": "string"
          },
          "score": {
            "type": "integer"
          }
        },
        "required": [
          "userId",
          "login",
          "score"
        ]
      },
      "ParticipantDto": {
        "type": "object",
        "properties": {
          "place": {
            "type": "integer",
            "minimum": 1
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "login": {
            "type": "string"
          },
          "score": {
            "type": "integer"
          },
          "isMe": {
            "type": "boolean"
          }
        },
        "required": [
          "place",
          "userId",
          "login",
          "score",
          "isMe"
        ]
      },
      "RoundResponseDto": {
        "type": "object",
        "properties": {
          "round": {
            "$ref": "#/components/schemas/RoundDto"
          },
          "myScore": {
            "$ref": "#/components/schemas/MyScoreDto"
          },
          "total": {
            "type": "integer",
            "description": "Появляется после окончания окна приёма тапов (endAt + TAP_GRACE_SECONDS)"
          },
          "winner": {
            "nullable": true,
            "description": "Появляется после окончания окна приёма тапов (endAt + TAP_GRACE_SECONDS); null, если никто не набрал очков",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/WinnerDto"
              }
            ]
          },
          "participants": {
            "description": "Появляется вместе с total и winner; топ-50 по очкам, плюс строка запрашивающего игрока последней, если он ниже 50-го места",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParticipantDto"
            }
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "round",
          "myScore",
          "serverTime"
        ]
      },
      "TapDto": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "example": 1
          }
        },
        "required": [
          "count"
        ]
      },
      "TapResponseDto": {
        "type": "object",
        "properties": {
          "taps": {
            "type": "integer"
          },
          "score": {
            "type": "integer"
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "taps",
          "score",
          "serverTime"
        ]
      }
    }
  }
}
